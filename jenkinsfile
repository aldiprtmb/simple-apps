pipeline {
    agent { label 'ubuntu01-aldi' }

    stages {
        stage('Pull SCM') {
            steps {
                git branch: 'main', url: 'https://github.com/aldiprtmb/simple-apps.git'
            }
        }

        
        stage('Build') {
            steps {
                sh'''
                npm install
                '''
            }
        }
        
        stage('Testing') {
            steps {
                sh'''
                npm test
                npm run test:coverage
                '''
            }
        }
        
        stage('Code Review') {
            steps {
                sh'''
                cd app
                sonar-scanner \
                    -Dsonar.projectKey=simple-apps \
                    -Dsonar.sources=. \
                    -Dsonar.host.url=http://172.23.1.141:9000 \
                    -Dsonar.login=sqp_1604a54b353a72e58db6fccb216067da00dbbca0
                '''
            }
        }
        
        stage('Deploy') {
            steps {
                sh'''
                docker compose up --build -d
                '''
            }
        }
        
        stage('Backup') {
            steps {
                 sh 'docker compose push' 
            }
        }
    }
}